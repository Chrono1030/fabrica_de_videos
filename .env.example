OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_INPUT_USD_PER_1M=0.10
OPENAI_OUTPUT_USD_PER_1M=0.50
MAX_API_BUDGET_USD=5.00
PIPER_VOICE_MODEL=/opt/voices/es_MX-ald-medium.onnx
# Dejar vacío para usar API Python persistente; ejecutable opcional compatible.
PIPER_EXECUTABLE=
PIPER_MODELS_DIR=out/models
PIPER_VOICE=es_MX-ald-medium
PIPER_LENGTH_SCALE=1.0
PIPER_TIMEOUT=180
# ARS o USD solo si el contexto del guion determina el significado de $.
NARRATION_CURRENCY=
FFMPEG_EXECUTABLE=ffmpeg
FONT_PATH=/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf
PUBLISH_ENABLED=false
YOUTUBE_PRIVACY=private
N8N_ENCRYPTION_KEY=
